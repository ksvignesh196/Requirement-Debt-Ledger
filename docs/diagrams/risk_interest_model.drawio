<mxfile host="app.diagrams.net" modified="2026-10-16T19:30:00.000Z" agent="Antigravity RDL" version="21.0.0" type="device">
  <diagram id="rdl-risk-model" name="Risk and Interest Escalation Model">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="560" background="#0f172a">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="title" value="Mathematical Risk &amp; Debt Interest Escalation Model" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="480" height="30" as="geometry" />
        </mxCell>

        <!-- Step 1: Inputs -->
        <mxCell id="box1" value="1. INPUT VECTORS&#xa;• Business Impact (1-5)&#xa;• Architecture Impact (1-5)&#xa;• Compliance Impact (1-5)&#xa;• Occurrence Likelihood (1-5)&#xa;• Detection Invisibility (1-5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;fontColor=#f8fafc;align=left;spacingLeft=10;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="180" height="130" as="geometry" />
        </mxCell>

        <!-- Step 2: Base Risk -->
        <mxCell id="box2" value="2. BASE STATIC RISK (R₀)&#xa;Severity (I) = 0.35·S_b + 0.35·S_a + 0.30·S_s&#xa;&#xa;R₀ = (I × O × D / 125) × 100&#xa;(Scale: 0.8 to 100.0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;fontColor=#f8fafc;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="250" y="90" width="200" height="130" as="geometry" />
        </mxCell>

        <!-- Step 3: Compounding Interest -->
        <mxCell id="box3" value="3. TIME DEBT INTEREST&#xa;Grace Period: 14 Days&#xa;Daily Rate (r): 0.8%&#xa;&#xa;Interest = (1 + 0.008)^max(0, Δt - 14)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#fbbf24;fontColor=#f8fafc;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="490" y="90" width="210" height="130" as="geometry" />
        </mxCell>

        <!-- Step 4: Overdue Penalty -->
        <mxCell id="box4" value="4. OVERDUE PENALTY&#xa;Review Date Breach Check&#xa;+25% per 30 days overdue&#xa;&#xa;Factor = 1.0 + min(1.0, d/30 × 0.25)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f87171;fontColor=#f8fafc;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="740" y="90" width="200" height="130" as="geometry" />
        </mxCell>

        <!-- Dynamic Risk -->
        <mxCell id="box5" value="DYNAMIC EFFECTIVE RISK R(t)&#xa;R(t) = min(100, R₀ × Interest × Overdue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#34d399;fontColor=#34d399;fontStyle=1;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="340" y="270" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- Priority Index -->
        <mxCell id="box6" value="DEBT PRIORITY INDEX (DPI)&#xa;0.45·R(t) + 0.25·DownstreamBlocked + 0.20·Urgency + 0.10·CostOfDelay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#818cf8;fontColor=#f8fafc;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="270" y="380" width="440" height="60" as="geometry" />
        </mxCell>

        <!-- Connectors -->
        <mxCell id="e1" edge="1" parent="1" source="box1" target="box2" style="strokeColor=#38bdf8;strokeWidth=2;" />
        <mxCell id="e2" edge="1" parent="1" source="box2" target="box3" style="strokeColor=#38bdf8;strokeWidth=2;" />
        <mxCell id="e3" edge="1" parent="1" source="box3" target="box4" style="strokeColor=#38bdf8;strokeWidth=2;" />
        <mxCell id="e4" edge="1" parent="1" source="box4" target="box5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#38bdf8;strokeWidth=2;">
          <Array as="points">
            <mxPoint x="840" y="305" />
          </Array>
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="box5" target="box6" style="strokeColor=#34d399;strokeWidth=2;" />

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
